# 复制本文件为 .env.local 后填入真实值。
# .env.local 已被 .gitignore 忽略，切勿把真实密钥写回本文件。

# APIMart
APIMART_API_KEY=your-apimart-api-key
APIMART_BASE_URL=https://api.apimart.ai/v1
# 仅本地开发需要走代理时填写
APIMART_PROXY_URL=http://127.0.0.1:7890
APIMART_SYNC_BATCH_SIZE=20

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# 服务端专用，切勿暴露到客户端
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_GENERATED_IMAGES_BUCKET=generated-images
SUPABASE_CANVAS_ASSETS_BUCKET=canvas-assets

# 梦工厂 MengFactory
MENGFACTORY_API_KEY=your-mengfactory-api-key
MENGFACTORY_BASE_URL=https://api.mengfactory.cn

# 云雾 Yunwu
YUNWU_API_KEY=your-yunwu-api-key
YUNWU_BASE_URL=https://yunwu.ai

# VectorEngine
VECTORENGINE_API_KEY=your-vectorengine-api-key
VECTORENGINE_BASE_URL=https://api.vectorengine.cn

# 晚喵 Manju
MANJU_API_KEY=your-manju-api-key
MANJU_BASE_URL=https://manjuapi.com

# GRSAI
GRSAI_API_KEY=your-grsai-api-key
GRSAI_BASE_URL=https://grsaiapi.com

# 定时任务鉴权，建议用 openssl rand -base64 32 生成
CRON_SECRET=your-cron-secret
